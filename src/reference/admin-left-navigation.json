[
  {
    "title": "User Configuration",
    "icon": "mdi-account-plus", 
    "provider_reg_type": ["PHO", "CHO", "MHO", "RHU", "BRGY", "DH","PVT-D", "PVT-P"],
    "routes": [
      {
        "title": "Registered Users",
        "path": "/admin/registered-users"
      },
      {
        "title": "Add New User",
        "path": "/admin/user-registration"
      }
    ]
  },
  {
    "title": "User-Defined Configuration",
    "icon": "mdi-cog-outline",
    "provider_reg_type": ["PHO", "CHO", "MHO", "RHU", "BRGY", "DH","PVT-D", "PVT-P"],
    "routes": [
      {
        "title": "Provider Logo",
        "path": "/admin/provider-logo"
      },
      {
        "title": "Disclaimer / About Us",
        "path": "/admin/disclaimer"
      },
      {
        "title": "News / Announcements",
        "path": "/admin/news-announcements"
      }
    ]
  },
  {
    "title": "Report Generating Module",
    "icon": "mdi-folder-open",
    "provider_reg_type": ["PHO", "CHO", "MHO", "RHU", "BRGY", "DH"],
    "routes": [
      {
        "title": "Top Cases",
        "path": "/admin/top-cases"
      },
      {
        "title": "Costs of Procedures",
        "path": "/admin/cost-of-procedure"
      },
      {
        "title": "Medical Transaction Report",
        "path": "/admin/medical-transaction-report",
        "report_condition": "this.$store.state?.prv_config?.access_patient_records != 0 "
      },
      {
        "title": "M1 Report",
        "path": "/admin/m1-report"
      },
      {
        "title": "M2 Report",
        "path": "/admin/m2-report"
      },
      {
        "title": "Medicine Consumption Report",
        "path": "/admin/medicine-consumption-report"
      },
      {
        "title": "Member List",
        "path": "/admin/konsulta-member"
      }
    ]
  },
  {
    "title": "Provider Setup & Migration",
    "icon": "mdi-database-import",
    "provider_reg_type": ["PHO", "CHO", "MHO", "RHU", "BRGY", "DH"],
    "routes": [
      {
        "title": "Migration",
        "path": "/admin/phic-migration-setup"
      },
      {
        "title": "Provider Accreditation",
        "path": "/admin/provider-accreditation"
      },
      {
        "title": "XML Downloads",
        "path": "/admin/xml-downloads"
      }
    ]
  },
  
  {
    "title": "Yakap",
    "icon": "mdi-folder-open",
    "provider_reg_type": ["PHO", "CHO", "MHO", "RHU", "BRGY", "DH"],
    "routes": [
      {
        "title": "Yakap Submission",
        "path": "/admin/ekonsulta-submission",
        "disabled": "this.$store.state?.prv_data?.phic_acc_no === ''",
        "ekonsulta_condition": "this.$store.state?.prv_data?.phic_acc_no === ''"
      },
      {
        "title": "Yakap XML Record Extraction",
        "path": "/admin/unrestrict",
        "disabled": "this.$store.state?.prv_data?.phic_acc_no === ''",
        "ekonsulta_condition": "this.$store.state?.prv_data?.phic_acc_no === ''",
        "bypass_condition": "this.$store.state?.prv_config?.access_ekonsulta_bypass === '1'"
      },
      {
        "title": "Yakap Report",
        "path": "/admin/report-submission",
        "disabled": "this.$store.state?.prv_data?.phic_acc_no === ''",
        "ekonsulta_condition": "this.$store.state?.prv_data?.phic_acc_no === ''"
      },
      {
        "title": "Yakap Eligibility Status",
        "path": "/admin/ekonsulta-eligibility-status",
        "disabled": "this.$store.state?.prv_data?.phic_acc_no === ''",
        "ekonsulta_condition": "this.$store.state?.prv_data?.phic_acc_no === ''"
      }
    ]
  },
  
  {
    "title": "Medicine Inventory",
    "icon": "mdi-clipboard-list",
    "provider_reg_type": ["PHO", "CHO", "MHO", "RHU", "BRGY", "DH","PVT-P"],
    "routes": [
      {
        "title": "Costs of Medicines",
        "path": "/admin/costs-of-medicine"
      },
      {
        "title": "Inventory",
        "path": "/admin/inventory"
      },
      {
        "title": "History",
        "path": "/admin/history"
      },
      {
        "title": "Transfer",
        "path": "/admin/transfer",
        "med_condition": "this.$store.state?.usr_credentials?.provider_reg_type !== 'PVT-P'"
      },
      {
        "title": "Received",
        "path": "/admin/received",
        "med_condition": "this.$store.state?.usr_credentials?.provider_reg_type !== 'PVT-P'"
      }
    ]
  }
]
